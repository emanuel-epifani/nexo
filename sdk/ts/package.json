{
  "name": "@emanuelepifani/nexo-client",
  "version": "7.0.0",
  "description": "High-performance TypeScript Client for Nexo Broker",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emanuel-epifani/nexo.git"
  },
  "keywords": [
    "microservices",
    "event-driven",
    "message-broker",
    "queue",
    "job-queue",
    "stream",
    "event-streaming",
    "event-sourcing",
    "pubsub",
    "realtime",
    "store",
    "key-value-store",
    "typescript",
    "high-performance"
  ],
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "tsx": "^4.23.15"
  }
}
